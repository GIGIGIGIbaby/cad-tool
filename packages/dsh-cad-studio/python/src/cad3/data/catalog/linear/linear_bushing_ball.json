{
  "schema": "cadparts.catalog-family/v1",
  "id": "linear.bushing.ball",
  "category": "linear",
  "name": "Linear ball bushing / 直线轴承",
  "summary": "LM/LME cylindrical and LMF/LMK flanged bushing proxies for round shafts.",
  "aliases": [
    "linear_bushing",
    "linear_bearing",
    "直线轴承",
    "法兰直线轴承"
  ],
  "keywords": [
    "linear bearing",
    "直线轴承",
    "LM",
    "LME",
    "LMF",
    "LMK",
    "圆法兰",
    "方法兰"
  ],
