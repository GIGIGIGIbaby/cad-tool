    "style": [
      "LM",
      "LME",
      "LMF",
      "LMK"
    ],
    "bore": [
      "8",
      "10",
      "12",
      "16",
      "20",
      "25",
      "30",
      "40"
    ],
    "seal": [
      "UU",
      "unspecified"
    ]
  },
  "compatibility": {
    "level": "series_compatible",
    "claim": "Style and bore narrow selection; outside diameter, length, flange pattern, seal suffix and fit must match the chosen catalog.",
    "match_fields": [
      "bore_diameter",
      "outside_diameter",
      "body_length",
      "flange_shape",
      "flange_size",
      "flange_hole_pitch"
    ]
  },
  "geometry": {
    "fidelity": "body/bore and optional round/square flange mounting proxy",
    "accurate": [
      "declared bore",
      "outer envelope",
      "length",
      "flange envelope and hole pattern"
    ],
    "omitted": [
      "ball tracks",
      "retainer",
      "seals",
      "snap-ring grooves",
      "load rating"
    ]
  },
  "interfaces": [
    {
      "id": "shaft_bore",
      "type": "cylindrical_bore",
      "role": "round-shaft location and travel"
    },
    {
      "id": "motion_axis",
      "type": "linear_axis",
      "role": "bushing translation"
    },
    {
      "id": "mounting_flange",
      "type": "round_or_square_flange",
      "role": "LMF/LMK moving-load attachment"
    }
  ],
  "keepouts": [
    {
      "id": "moving_bushing",
      "purpose": "Bushing outer envelope while translating on the shaft."
    }
  ],
  "purchase": {
    "designation_template": "{style}{bore} linear ball bushing",
    "note": "Select seal, length suffix, accuracy and fit after layout."
  },
  "sample": {
