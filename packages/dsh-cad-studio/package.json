{
  "name": "dsh-cad-studio",
  "version": "3.0.0-alpha.1",
  "description": "DSH plugin for FreeCAD-native CAD modeling: run, inspect, render, mates, standard-parts catalog and Git design snapshots",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "python/cad3.py",
    "python/src/cad3",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/register.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liwuzhan/cad-tool.git",
    "directory": "packages/dsh-cad-studio"
  },
  "homepage": "https://github.com/liwuzhan/cad-tool/tree/main/packages/dsh-cad-studio",
  "bugs": {
    "url": "https://github.com/liwuzhan/cad-tool/issues"
  },
  "keywords": [
    "dsh-plugin",
    "cad",
    "freecad",
    "step",
    "git"
  ],
  "engines": {
    "dsh": "^0.2.1-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
